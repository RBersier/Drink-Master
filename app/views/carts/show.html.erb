<% content_for :title, "Cart" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Cart</h1>
    <%= link_to "Back to drinks", drinks_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
  </div>

  <div id="cart" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @cart.cart_items.any? %>
      <%= button_to "Empty cart", cart_path, method: :delete, class: "rounded-md px-3.5 py-2.5 bg-orange-600 hover:bg-orange-500 text-white block font-medium" %>

      <% @cart.cart_items.each do |cart_item| %>
        <div class="grid grid-cols-3 items-center gap-2 py-5 font-medium">
          <div class="[overflow-wrap:anywhere]"><%= cart_item.drink.name %></div>
          <div class="text-center">Quantity: <%= cart_item.quantity || 1 %></div>
          <div class="text-right">
            <div>Unit price: <%= cart_item.drink.price %></div>
            <div>Total price: <%= cart_item.total %></div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">Your cart is empty</p>
    <% end %>
  </div>
</div>
